{
  "name": "legend-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "传奇世界桌面游戏客户端",
  "scripts": {
    "test": "vite build --ssr tests/index.test.ts --outDir node_modules/.tmp/core-tests && node --test node_modules/.tmp/core-tests/index.test.js",
    "dev": "vite",
    "dev:electron": "node scripts/electron-dev.mjs",
    "start:electron": "electron .",
    "pack:electron": "pnpm build && electron-builder --dir",
    "build:electron": "pnpm build && electron-builder",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
